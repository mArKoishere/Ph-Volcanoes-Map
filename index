#lg{display:block;max-width:250px;padding:10px 12px}#lg summary{cursor:pointer;font-size:15px}
.lgi{display:flex;align-items:center;gap:8px;background:none;border:0;color:var(--tx);font:12px system-ui;padding:5px 0;width:100%;text-align:left;cursor:pointer}.lgi.off{opacity:.35;text-decoration:line-through}
#lg small{display:block;margin-top:4px}#lg[style*="opacity: 0"]{pointer-events:none}
