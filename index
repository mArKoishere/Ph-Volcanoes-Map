#sheet.on{transform:none}
@media(min-width:800px){#sheet{left:auto;right:16px;top:70px;bottom:16px;width:380px;max-height:none;border-radius:22px;transform:translateX(115%)}#sheet.on{transform:none}}
#x{position:absolute;top:10px;right:10px;width:34px;height:34px;border-radius:50%;border:0;background:#0009;color:#fff;font-size:18px;cursor:pointer;z-index:2}
#art{display:block;width:100%;height:auto}
.in{padding:16px 18px 22px}.in h2{margin:0 0 4px;font-size:28px}
.ch{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}.ch span{background:#ffffff14;border:1px solid var(--edge);border-radius:8px;padding:4px 9px;font-size:12px}
.in p{line-height:1.55;margin:8px 0;max-width:62ch}.in ul{padding:0;margin:12px 0;list-style:none}
.in li{padding:10px 12px;margin:8px 0;border-left:3px solid var(--fire);background:#ffffff0d;border-radius:0 10px 10px 0;line-height:1.45;opacity:0;animation:up .6s ease forwards;animation-delay:calc(.35s + var(--i)*.12s)}
