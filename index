.ln{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}.ln a{text-decoration:none}details.al{font-size:13px;color:var(--mut)}
.gr{stroke:var(--edge);stroke-width:1;opacity:.18}.gt{fill:var(--mut);font:13px system-ui;opacity:.7}
.in h3{margin:16px 0 4px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--fire)}
