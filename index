const A=V.map((v,i)=>[v,i]).filter(([v])=>v.s=="a").sort((a,b)=>a[0].n.localeCompare(b[0].n));
show(`<div class="in"><h2>${A.length} active volcanoes</h2><p>Active means erupted within about the last 600 years, with documented accounts (PHIVOLCS). Tap one to fly to it.</p>${A.map(([v,i],j)=>`<button class="li" onclick="pick(${i})"><b>${j+1}</b><span>${v.n}<small>${v.l} · ${v.h}</small></span><em>${E[v.n]||''}</em></button>`).join('')}</div>`)}
$('#lb').textContent='All '+V.filter(v=>v.s=="a").length+' active';$('#lb').onclick=list;

const PH={};// real photos go here, e.g. PH["Iriga"]=["data:image/jpeg;base64,..."]
const VN=["dusk","day","night"];
function gal(v){const sl=[...(PH[v.n]||[]).map(u=>`<div class="sl"><img src="${u}" alt="${v.n} volcano"><i class="cap">Photo</i></div>`),...[0,1,2].map(q=>`<div class="sl">${art(v,q)}<i class="cap">Illustration · ${VN[q]}</i></div>`)];
return `<div id="gal"><div class="tk">${sl.join('')}</div><button class="ar l" aria-label="Previous" onclick="gs(-1)">‹</button><button class="ar r" aria-label="Next" onclick="gs(1)">›</button><div class="dt">${sl.map((_,i)=>`<i${i?'':' class="on"'}></i>`).join('')}</div></div>`}
function gs(d){const t=$('#gal .tk');t.scrollBy({left:d*t.clientWidth,behavior:'smooth'})}
document.addEventListener('scroll',e=>{const t=e.target;if(t.classList&&t.classList.contains('tk')){const i=Math.round(t.scrollLeft/t.clientWidth);t.parentNode.querySelectorAll('.dt i').forEach((d,j)=>d.classList.toggle('on',j==i))}},true);
