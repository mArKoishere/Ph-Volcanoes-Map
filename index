.li{display:flex;gap:10px;align-items:center;width:100%;background:#ffffff0d;border:0;color:var(--tx);padding:10px 12px;border-radius:10px;margin:6px 0;text-align:left;cursor:pointer;font:600 14px system-ui}
.li b{color:var(--act);width:22px}.li span{flex:1}.li small{display:block;color:var(--mut);font-weight:400;font-size:12px}.li em{color:var(--mut);font-size:12px;font-style:normal}
