const more2=v=>{const z=Z[v.n]||{};return `${z.tl?`<h3>Eruption history</h3><ol class="tl">${z.tl.map(([y,t])=>`<li><b>${y}</b>${t}</li>`).join('')}</ol>`:''}<h3>Hazards</h3><p>${z.hz||"Typical volcano hazards: ashfall, pyroclastic flows, lahars and lava flows."}</p><h3>Did you know?</h3><p>${z.dy||(v.s=="a"?"PHIVOLCS monitors this volcano as one of the country's 24 active volcanoes.":"Potentially active volcanoes look young but have no historical eruption on record.")}</p>`+more(v)};
