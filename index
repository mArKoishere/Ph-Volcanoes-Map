#intro h1 span{display:inline-block;opacity:0;animation:up .8s ease forwards;animation-delay:calc(.6s + var(--i)*.09s)}
#intro p{opacity:0;animation:up 1s ease 1.9s forwards;color:#ffd2bd;margin:10px 20px 22px;max-width:44ch}
#go{opacity:0;animation:up 1s ease 2.4s forwards;background:var(--fire);color:#fff;border:0;border-radius:99px;padding:13px 30px;font:700 16px system-ui;cursor:pointer;box-shadow:0 0 30px #ff6a3d88}
