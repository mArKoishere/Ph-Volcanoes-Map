const a=P[0],b=P[P.length-1],m=P[P.length>>1];let g=Math.atan2(b[1]-a[1],b[0]-a[0])*180/Math.PI;if(g>90||g<-90)g+=180;mkE('text',{class:'trl',transform:`translate(${m[0]+o} ${m[1]}) rotate(${g})`,'text-anchor':'middle'},tr).textContent=n});
$('#arc').setAttribute('points',["Iraya","Babuyan Claro","Didicas","Cagua","Pinatubo","Natib","Mariveles","Taal","Banahaw","Isarog","Iriga","Mayon","Bulusan"].map(n=>{const v=V.find(x=>x.n==n);return v.x.toFixed(0)+','+v.y.toFixed(0)}).join(' '));
document.querySelectorAll('.lgi[data-f]').forEach(b=>b.onclick=()=>{const f=b.dataset.f;if(f=='arc')return arc();b.classList.toggle('off');const h=b.classList.contains('off');
if(f=='tr')$('#trs').style.display=h?'none':'';else if(f=='gr')$('#grid').style.display=h?'none':'';else document.querySelectorAll('.mk').forEach(m=>{if(V[m.dataset.i].s==f)m.style.display=h?'none':''})});
if(mob())$('#lg').open=false;

const Z={
Mayon:{tl:[["1616","First recorded eruption"],["1814","Cagsawa eruption buries a town; about 1,200 die"],["1897","Lava and pyroclastic flows kill about 350"],["1993","Pyroclastic flows kill 77"],["2006","Typhoon Durian lahars kill over 1,000"],["2018","Lava fountaining; tens of thousands evacuate"],["2023–24","Long lava-flow eruption with rockfalls"]],hz:"Lava flows, pyroclastic flows, lahars and ashfall. A 6-km permanent danger zone surrounds the crater.",dy:"Legend says the cone is the resting place of Daragang Magayon, the 'beautiful maiden'."},
Taal:{tl:[["1572","Earliest recorded eruption"],["1754","Months-long eruption destroys towns"],["1911","Base surge kills over 1,300"],["1965","Base surge kills about 200"],["2020","Ash falls on Manila; hundreds of thousands displaced"]],hz:"Base surges, ashfall, volcanic earthquakes and lake tsunamis. All of Volcano Island is a Permanent Danger Zone.",dy:"The 2020 eruption boiled away the crater lake on Volcano Island."},
Pinatubo:{tl:[["Before 1991","Dormant for roughly 500 years"],["Jun 15, 1991","Huge VEI-6 eruption"],["1992 on","Lahars bury towns each rainy season for years"]],hz:"Lahars remain the long-term hazard as typhoon rains wash loose ash down the rivers.",dy:"Hikers now reach the turquoise crater lake through a canyon carved by lahars."},
Bulusan:{tl:[["1852","First recorded eruption"],["2010–11","Explosive steam blasts"],["2015–17","Series of phreatic eruptions"],["Jun 2022","Phreatic eruption sends ash over Sorsogon"]],hz:"Sudden steam blasts, ashfall and lahars.",dy:"Bulusan Lake, a crater lake on its foot slope, is a nature park."},
