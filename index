<title>Volcanoes of the Philippines</title>
<style>
:root{--bg:#081522;--sea:#0c2136;--land:#1d4560;--edge:#3f7ba0;--tx:#e9f2f8;--mut:#9bb2c4;--panel:#0d2238f2;--fire:#ff6a3d;--act:#ff3b30;--pot:#ffd60a;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]){--bg:#e8f0f6;--sea:#d3e4f0;--land:#9dbdd3;--edge:#5f8fae;--tx:#10243a;--mut:#4a6479;--panel:#fffffff2}}
*{box-sizing:border-box}html,body{height:100%;margin:0}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{background:var(--bg);color:var(--tx);font-family:system-ui,-apple-system,"Segoe UI",sans-serif;overflow:hidden}
h1,h2,.serif{font-family:Georgia,"Times New Roman",serif;font-weight:700}
#map{position:absolute;inset:0;width:100%;height:100%;background:radial-gradient(circle at 50% 40%,var(--sea),var(--bg))}
.land{fill:var(--land);stroke:var(--edge);stroke-width:2;stroke-linejoin:round}
.isl{fill:var(--mut);opacity:.35;font:700 34px Georgia,serif;letter-spacing:8px}
.tr{fill:none;stroke:var(--fire);stroke-width:3;stroke-dasharray:10 8;opacity:.6}
.trl{fill:var(--mut);font:italic 20px Georgia,serif}
#arc{fill:none;stroke:var(--fire);stroke-width:7;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:1;stroke-dashoffset:1;opacity:0;transition:opacity .4s;filter:drop-shadow(0 0 6px var(--fire))}
#arc.on{opacity:.9;animation:draw 2.4s ease forwards}
@keyframes draw{to{stroke-dashoffset:0}}
.mk{cursor:pointer;transition:opacity .4s}.mk .tri{stroke:#fff;stroke-width:2.5;transition:transform .3s}
.mk:hover .tri,.mk.sel .tri{transform:scale(1.35)}
.ring{fill:none;stroke-width:3;transform-box:fill-box;transform-origin:center;animation:pulse 2.4s ease-out infinite}
@keyframes pulse{from{transform:scale(.6);opacity:.9}to{transform:scale(2.4);opacity:0}}
.lb{fill:var(--tx);font:600 17px system-ui,sans-serif;paint-order:stroke;stroke:var(--bg);stroke-width:4px;transition:opacity .5s;pointer-events:none}
#bar{position:absolute;top:calc(env(safe-area-inset-top,0px) + 10px);left:10px;right:10px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;pointer-events:none}
#bar>*{pointer-events:auto}
.pill{background:var(--panel);border:1px solid var(--edge);color:var(--tx);border-radius:99px;padding:9px 14px;font:600 13px system-ui;cursor:pointer;backdrop-filter:blur(8px)}
.pill.on{background:var(--fire);border-color:var(--fire);color:#fff}
#bar h1{margin:0 auto 0 4px;font-size:18px}
#lg{position:absolute;left:12px;bottom:calc(env(safe-area-inset-bottom,0px) + 12px);font-size:12px;color:var(--mut);background:var(--panel);padding:8px 12px;border-radius:12px;display:flex;gap:12px;transition:opacity .4s}
.d{display:inline-block;width:0;height:0;border:6px solid transparent;border-bottom:10px solid;border-top:0;margin-right:5px}
